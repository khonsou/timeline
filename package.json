{
  "name": "timeline-board",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "拾光轴 · Timeline Board —— npm workspaces 单仓库分包（core 契约层 / server / cli / web）",
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w web",
    "lint": "eslint .",
    "preview": "npm run preview -w web",
    "import:data": "node packages/cli/import-data.mjs",
    "test:core": "node --test \"packages/core/test/*.test.mjs\"",
    "test:server": "node packages/server/test/smoke.mjs",
    "test:e2e": "node web/verification/e2e-check.mjs"
  }
}
